# ---- ClipFlow settings. Copy this file to .env and fill it in. Never commit .env. ----
#
# On your own computer you need nothing here: start ClipFlow, open it, and add your AI key under Settings, AI.
# This file is for servers, and for anyone who prefers to keep settings in a file.
# Note: For backward compatibility, both CLIPFLOW_* and PEAKCUT_* variable names are supported.

# ================================================================ AI: bring your own key
# The easy way is the dashboard: Settings, AI. Whatever is saved there is used instead of these lines.
# ClipFlow uses an AI model to pick the moments worth clipping and to write hooks, titles and captions.
# You choose the service and pay that service directly; ClipFlow adds nothing on top.
# Without a key ClipFlow still works: clips are then picked by loudness only, with no titles.
#
#   provider     where to get a key                          example model ids
#   gemini       https://aistudio.google.com/apikey           gemini-2.5-flash
#   openai       https://platform.openai.com/api-keys         gpt-4o-mini
#   deepseek     https://platform.deepseek.com                deepseek-chat
#   mistral      https://console.mistral.ai                   mistral-small-latest
#   xai          https://console.x.ai                         grok-4            (Grok)
#   groq         https://console.groq.com/keys                llama-3.3-70b-versatile
#   openrouter   https://openrouter.ai/keys                   any model id listed there
#   anthropic    https://console.anthropic.com                a current Claude model id
#   ollama       no key: a model running on this machine      llama3.1          (ollama pull llama3.1)
#   custom       any service that speaks the OpenAI chat format: also set CLIPFLOW_AI_BASE_URL
CLIPFLOW_AI_PROVIDER=gemini
CLIPFLOW_AI_MODELS=
CLIPFLOW_AI_KEY=
# CLIPFLOW_AI_KEY_FILE=/secrets/ai.txt        # instead of CLIPFLOW_AI_KEY: a file that holds the key
# CLIPFLOW_AI_BASE_URL=                       # only for "custom", e.g. http://127.0.0.1:1234/v1
# CLIPFLOW_AI_MODELS takes several ids separated by commas. They are tried in order as fallbacks.

# ================================================================ video & social safe margin presets
# CLIPFLOW_OUT_W=1080                         # target clip width (default: 1080)
# CLIPFLOW_OUT_H=1920                         # target clip height (default: 1920, 9:16 vertical)
# CLIPFLOW_OUT_FPS=30                         # target frame rate (30 or 60)
# CLIPFLOW_CRF=21                             # x264 video quality factor (18-28; 21 is high quality)
# CLIPFLOW_PRESET=veryfast                    # ffmpeg encoding preset (ultrafast, veryfast, faster, fast)
# CLIPFLOW_SAFE_MARGIN=reels                  # safe margin layout: reels, tiktok, shorts, none

# ================================================================ on a server (Docker): see DEPLOY.md
# Your domain (DNS must already point at this server) and a database password you make up.
# CLIPFLOW_DOMAIN=clipflow.example.com
# POSTGRES_PASSWORD=change-me-to-a-long-random-string

# A server ClipFlow has to itself: keep this line, and ClipFlow fetches its own HTTPS certificate.
# A server that already runs a web server for other sites: leave it out and see deploy/nginx-peakcut.conf.
# COMPOSE_PROFILES=own-https
# Behind Cloudflare's CDN: put the Cloudflare origin certificate in ./secrets as cloudflare-origin.crt and
# cloudflare-origin.key, and use the Caddyfile that serves it.
# CLIPFLOW_CADDYFILE=Caddyfile.origin
# CLIPFLOW_BIND_PORT=8765           # the port ClipFlow listens on inside the server, if 8765 is taken
# Behind a Traefik that is already on the server, use this instead of the own-https line:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml
# If the domain goes through Cloudflare's CDN (orange cloud), the visitor's real address comes in this header.
# CLIPFLOW_CLIENT_IP_HEADER=CF-Connecting-IP

# On a server shared with other apps: keep ClipFlow inside its own share.
# CLIPFLOW_MEM_LIMIT=2g             # most memory it may use (stopped first if it goes over)
# CLIPFLOW_CPUS=1.5                 # most processor cores it may use
# CLIPFLOW_CPU_SHARES=256           # its turn at the processor when the server is busy (1024 is normal)
# CLIPFLOW_OOM_SCORE_ADJ=900        # if the whole server runs out of memory, ClipFlow is stopped first
# CLIPFLOW_DB_MEM_LIMIT=256m

# ================================================================ where things are kept (own computer)
# CLIPFLOW_DATA=./data              # videos, clips, the database file and the speech model
# CLIPFLOW_PORT=8765
# CLIPFLOW_PUBLIC_URL=http://127.0.0.1:8765     # the address people open; set it to https://your-domain on a server
# DATABASE_URL=                    # empty: a SQLite file in the data folder. Or postgresql+psycopg://user:pass@host/db

# ================================================================ sign-in
# Off by default: ClipFlow opens straight into the dashboard, which is right for your own computer.
# On a server that other people can reach, set CLIPFLOW_ACCOUNTS=1.
CLIPFLOW_ACCOUNTS=0
# CLIPFLOW_SESSION_DAYS=30
# CLIPFLOW_VERIFY_EMAIL=1           # password sign-ups must confirm email before clipping
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/secrets/google-client.json

# ================================================================ email (for confirmation & password reset)
# CLIPFLOW_SMTP_HOST=smtp.postmarkapp.com
# CLIPFLOW_SMTP_PORT=587
# CLIPFLOW_SMTP_USER=your-postmark-token
# CLIPFLOW_SMTP_PASSWORD=your-postmark-token
# CLIPFLOW_MAIL_FROM=ClipFlow <clips@your-domain.com>
# CLIPFLOW_CONTACT_EMAIL=support@your-domain.com
